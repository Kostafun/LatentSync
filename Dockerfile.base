FROM runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/workspace

# Create Python symlinks
RUN ln -sf $(which python3.11) /usr/local/bin/python && \
    ln -sf $(which python3.11) /usr/local/bin/python3

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Install system dependencies
RUN apt update && \
    apt upgrade -y && \
    apt install -y \
      python3-dev \
      python3-pip \
      python3-venv \
      python3-tk \
      git \
      git-lfs \
      wget \
      curl \
      ffmpeg \
      unzip && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean -y

# Install uv for faster Python package management
ENV XDG_BIN_HOME=/usr/bin
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Set working directory
WORKDIR /workspace

# Create virtual environment
RUN /usr/bin/uv venv

# Copy requirements file only (for better layer caching)
COPY requirements.txt /workspace/requirements.txt

# Install Python dependencies in virtual environment
RUN /usr/bin/uv pip install -r requirements.txt

# Activate virtual environment
RUN source /workspace/.venv/bin/activate

# Create necessary directories for models and cache
RUN mkdir -p /workspace/checkpoints && \
    mkdir -p /root/.cache/torch/hub/checkpoints

# Download the large model files using huggingface-cli
RUN /usr/bin/uv run huggingface-cli download ByteDance/LatentSync latentsync_unet.pt --local-dir checkpoints 
RUN /usr/bin/uv run huggingface-cli download ByteDance/LatentSync whisper/tiny.pt --local-dir checkpoints 

# Create auxiliary model directory and download auxiliary models if needed
# Note: These auxiliary models will be linked in the application layer
RUN mkdir -p /workspace/checkpoints/auxiliary

# Set up environment for the application layer
ENV PATH="/workspace/.venv/bin:${PATH}"
ENV VIRTUAL_ENV="/workspace/.venv"

# Verify the setup
RUN echo "=== BASE IMAGE SETUP VERIFICATION ===" && \
    echo "Python version:" && python --version && \
    echo "Virtual environment:" && ls -la /workspace/.venv/ && \
    echo "Installed packages:" && /usr/bin/uv pip list && \
    echo "Downloaded models:" && ls -la /workspace/checkpoints/ && \
    echo "Model file sizes:" && du -sh /workspace/checkpoints/*.pt 2>/dev/null || echo "No .pt files found yet"

# This base image is now ready to be tagged and pushed to Docker Hub
# Example: docker build -f Dockerfile.base -t your-dockerhub-username/autotube-base:latest .
#          docker push your-dockerhub-username/autotube-base:latest